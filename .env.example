# --- Web (apps/web) ---
# Postgres connection string (local dev: docker compose up postgres)
DATABASE_URL=postgresql://cheatsheet:cheatsheet@localhost:5432/cheatsheet

# Secret used to sign the device_id session cookie (HMAC). 32+ random bytes.
# Rotate by setting a new value and redeploying — existing cookies will fail
# verification and users will be assigned a new device_id (and a new library).
SESSION_SECRET=replace-with-32-bytes-of-random-hex

# Worker base URL (used by web to request PDF renders)
WORKER_URL=http://localhost:4000

# Hard cap on a single render request to the worker (ms).
# Optional — defaults to 30000.
WORKER_RENDER_TIMEOUT_MS=30000

# Public app URL (used by worker to load /print/:id)
APP_URL=http://localhost:3000

# Anthropic API key for the "Generate from notes" feature.
# Optional — the sidebar button is hidden when this is unset.
ANTHROPIC_API_KEY=

# --- Worker (apps/worker) ---
# Same DATABASE_URL as web
# Same APP_URL as web
PORT=4000

# Shared secret between web and worker for the render endpoint.
# 32+ random bytes. Rotate by:
#   1. Generate a new value (`openssl rand -hex 32`).
#   2. Redeploy worker with WORKER_SHARED_SECRET=<new>.
#   3. Redeploy web with the same value.
#   Brief 502s are expected during the rolling deploy window.
WORKER_SHARED_SECRET=replace-with-32-bytes-of-random-hex

# Per-IP rate limit for /render (requests per minute). Optional — default 20.
RATE_LIMIT_PER_MIN=20

# Hard cap on a single render duration (ms). Optional — default 45000.
RENDER_TIMEOUT_MS=45000
