# --- Web (apps/web) ---
# Postgres connection string (local dev: docker compose up postgres)
DATABASE_URL=postgresql://cheatsheet:cheatsheet@localhost:5432/cheatsheet

# Secret used to sign the device_id session cookie (HMAC). 32+ random bytes.
SESSION_SECRET=replace-with-32-bytes-of-random-hex

# Worker base URL (used by web to request PDF renders)
WORKER_URL=http://localhost:4000

# Public app URL (used by worker to load /print/:id)
APP_URL=http://localhost:3000

# --- Worker (apps/worker) ---
# Same DATABASE_URL as web
# Same APP_URL as web
PORT=4000

# Shared secret between web and worker for the render endpoint
WORKER_SHARED_SECRET=replace-with-32-bytes-of-random-hex
