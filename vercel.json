{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm db:migrate && pnpm --filter @cheatsheet/web build",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "outputDirectory": "apps/web/.next",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/web packages/db packages/shared package.json pnpm-lock.yaml vercel.json",
  "regions": ["sin1"]
}
